# JobPilot Monorepo .gitignore

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.jks
*.keystore
*credentials*.json
*client_secret*.json

# Node & Cloudflare Workers
node_modules/
dist/
.wrangler/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter & Dart
.dart_tool/
.packages
.pub/
.pub-cache/
build/
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# Android build outputs & local properties
app/android/local.properties
app/android/.gradle/
app/android/app/build/
*.apk
*.aab

# Coverage & Test artifacts
coverage/
*.lcov
test-results/

# OS and Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
